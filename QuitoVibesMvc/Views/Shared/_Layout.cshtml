<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quito Vibes | Municipio de Quito</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Municipio de Quito Theme -->
    <link rel="stylesheet" href="~/css/municipio-theme.css" asp-append-version="true" />
</head>
<body>
    <!-- Franja Tricolor Superior del Municipio de Quito -->
    <div class="quito-top-bar"></div>

    <!-- Sub-header Institucional -->
    <div class="bg-dark text-white py-1 px-4 d-none d-md-flex justify-content-between align-items-center style="font-size: 0.8rem; background-color: #001A2C !important;">
        <div>
            <i class="bi bi-geo-alt-fill text-danger me-1"></i> Distrito Metropolitano de Quito, Ecuador &nbsp;|&nbsp; 
            <i class="bi bi-calendar-event me-1"></i> Agenda Cultural Oficial
        </div>
        <div>
            <span class="badge bg-danger me-2">ALCALDÍA METROPOLITANA</span>
            <span class="text-light opacity-75">Quito Renace</span>
        </div>
    </div>

    <!-- Navbar Principal -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-quito">
        <div class="container-fluid px-4">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-building-fill-gear"></i>
                QUITO VIBES <span class="accent">MVC</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i> Inicio
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Eventos" ? "active" : "")" 
                           asp-controller="Eventos" asp-action="Index">
                            <i class="bi bi-calendar3 me-1"></i> Gestor CRUD Eventos <span class="badge bg-warning text-dark ms-1">Protegido</span>
                        </a>
                    </li>
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <!-- Main Container -->
    <main role="main" class="container py-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer Institucional -->
    <footer class="footer-quito">
        <div class="container text-center text-md-start">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <h5 class="text-white fw-bold"><i class="bi bi-building me-2"></i>Municipio del Distrito Metropolitano de Quito</h5>
                    <p class="small text-light opacity-75">
                        Sistema de Gestión Cultural Quito Vibes. Desarrollado con tecnología ASP.NET Core MVC bajo estándares de seguridad e identidad institucional.
                    </p>
                </div>
                <div class="col-md-3 mb-3">
                    <h6 class="text-white fw-bold">Enlaces Rápidos</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li><a asp-controller="Eventos" asp-action="Index">Gestor de Eventos</a></li>
                        <li><a asp-controller="Account" asp-action="Login">Iniciar Sesión</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-3">
                    <h6 class="text-white fw-bold">Seguridad</h6>
                    <p class="small text-light opacity-75">
                        <i class="bi bi-shield-lock-fill text-warning me-1"></i> Autenticación basada en Cookies.<br />
                        <i class="bi bi-key-fill text-warning me-1"></i> Encriptación MD5 en credenciales.
                    </p>
                </div>
            </div>
            <hr class="bg-secondary my-3" />
            <div class="text-center small text-light opacity-50">
                &copy; @DateTime.Now.Year Alcaldía Metropolitana de Quito - Todos los derechos reservados.
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
