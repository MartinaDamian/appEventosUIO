@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 text-center">
        <div class="card card-quito p-4 shadow-sm border-danger">
            <div class="card-body">
                <i class="bi bi-shield-slash-fill text-danger" style="font-size: 4rem;"></i>
                <h2 class="fw-bold text-dark mt-3">Acceso Denegado</h2>
                <p class="text-secondary my-3">
                    No tienes los permisos o la sesión requerida para acceder a este recurso del Municipio de Quito.
                </p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-quito-danger px-4 me-2">
                    <i class="bi bi-key-fill me-1"></i> Iniciar Sesión
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
                    Ir al Inicio
                </a>
            </div>
        </div>
    </div>
</div>
