@model QuitoVibesMvc.Models.EventoCultural

@{
    ViewData["Title"] = "Eliminar Evento Cultural";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card card-quito border-danger shadow-lg">
            <div class="card-header bg-danger text-white py-3 text-center">
                <i class="bi bi-exclamation-triangle-fill fs-2 d-block mb-1"></i>
                <h4 class="fw-bold mb-0">Confirmar Eliminación de Registro</h4>
            </div>
            <div class="card-body p-4 text-center">
                <p class="text-secondary fs-5">
                    ¿Estás seguro de que deseas eliminar permanentemente este evento de la agenda de Quito?
                </p>

                <div class="p-3 bg-light rounded border text-start my-3">
                    <h5 class="fw-bold text-dark mb-1">@Model.Titulo</h5>
                    <small class="text-muted d-block mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.Lugar - @Model.Fecha.ToString("dd/MM/yyyy")</small>
                    <p class="small text-secondary mb-0">@Model.Descripcion</p>
                </div>

                <div class="alert alert-warning small py-2">
                    <i class="bi bi-info-circle-fill me-1"></i> Esta acción no se puede deshacer. Se removerá del sistema de base de datos.
                </div>

                <form asp-action="Delete" method="post" class="mt-4">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold">
                            <i class="bi bi-trash-fill me-1"></i> Sí, Eliminar Evento
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
